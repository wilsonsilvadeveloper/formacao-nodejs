<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Hello World!</h1>
    <%= nome %>
    <p>Linguagem: <%= lang %></p>
    <p>Empresa: <%= empresa %></p>
    <p>Inscritos: <%= inscritos %></p>
    <% if(msg == true){ %>
        <h3>Mensagem de Erro</h3>
    <%} else {%>
        <h3>Sem Mensagem de Erro</h3>
    <%}%>
    <% produtos.forEach(function(produto){ %>
        <div>
            <h4><%= produto.nome %></h4>
            <p>R$ <%= produto.preco.toFixed(2) %></p>
        </div>
    <% }) %>
</body>
</html>
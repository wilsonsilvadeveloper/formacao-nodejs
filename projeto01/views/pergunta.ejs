<!DOCTYPE html>
<html lang="en">
<%- include("partials/header") %>
<body>
    <%- include("partials/navbar") %>
   <div class="container">
    <hr>
    <h1><%= pergunta.titulo %></h1>
    <p><%= pergunta.descricao %></p>
    <form action="/responder" id="form_resposta" method="post">
        <h3>Responda</h3>
        <label for="resposta">Resposta:</label>
        <textarea name="resposta" id="resposta" placeholder="Digite sua Resposta" class="form-control"></textarea>
        <br>
        <input type="hidden" name="id_pergunta" value="<%= pergunta.id %>">
        <button type="submit" class="btn btn-primary mt-2">Enviar Resposta</button>
    </form>
    <hr>
    <h3>Respostas</h3>
    <hr>
    <% respostas.forEach(resposta => { %>
        <br>
        <div class="card">
            <div class="card-body">
                <p><%= resposta.corpo %></p>
            </div>
        </div>
    <% }) %>
   </div>
</body>
<%- include("partials/footer") %>
</html>
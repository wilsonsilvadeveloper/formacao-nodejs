<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <title>Document</title>
</head>
<body>
    <nav class="navbar navbar-light bg-primary">
        <a href="/" class="navbar-brand">
            <img src="/img/guia.png" alt="">
        </a>
    </nav>
    <div class="container">
        <div class="card" id="formulario-perguntas">
            <div class="card-header">
                 <h3>Faca uma pergunta</h3>
            </div>
            <div class="card-body">
                <form action="">
                    <label for="">Titulo</label>
                    <input type="text" placeholder="Titulo" class="form-control">
                    <br>
                    <label for="">Descricao</label>
                    <textarea name="" id="" placeholder="Descreva sua pergunta aqui!" class="form-control"></textarea>
                    <br>
                    <button class="btn btn-primary">Perguntar</button>
                </form>
            </div>
        </div>
    </div>
</body>
<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js" integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y" crossorigin="anonymous"></script>
<script src="/js/bootstrap.min.js"></script>
</html>
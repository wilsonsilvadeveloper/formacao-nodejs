<!DOCTYPE html>
<html lang="en">
<%- include("partials/header") %>
<body>
    <%- include("partials/navbar") %>
    <div class="container">
        <div class="card" id="formulario-perguntas">
            <div class="card-header">
                 <h3>Faça uma pergunta</h3>
            </div>
            <div class="card-body">
                <form action="/salvarpergunta" method="post">
                    <label for="">Titulo</label>
                    <input type="text" name="titulo" placeholder="Titulo" class="form-control">
                    <br>
                    <label for="">Descricao</label>
                    <textarea name="descricao" id="" placeholder="Descreva sua pergunta aqui!" class="form-control"></textarea>
                    <br>
                    <button class="btn btn-primary">Perguntar</button>
                </form>
            </div>
        </div>
    </div>
</body>
<%- include("partials/footer") %>
</html>